# Copy to .env only when using Alpaca paper trading or the optional dashboard.
# Obtain a matching API key/secret pair from your Alpaca PAPER account.
# Offline replay and signal analysis do not need credentials.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# The paper endpoint is fixed by default. Live URLs and redirects are rejected.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Robinhood uses OAuth through `robinhood-mcp-wrapper auth login`, not these variables.
# The wrapper keeps OAuth tokens in its own per-user credential store.
# SweepFlow loads only Alpaca settings from this file.
